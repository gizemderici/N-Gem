APP_ENV=development
PORT=8080
# Varsayilan deger servisleri yalnizca bu bilgisayara acar. Fiziksel telefonla
# demo icin 0.0.0.0 yapin ve STORAGE_PUBLIC_ENDPOINT'i bilgisayarin LAN IP'sine ayarlayin.
DEMO_BIND_ADDRESS=127.0.0.1
DATABASE_URL=jdbc:postgresql://localhost:5432/nexi
DATABASE_USER=nexi
DATABASE_PASSWORD=nexi_dev_password
JWT_SECRET=replace-with-a-demo-only-secret-of-at-least-32-characters
JWT_ISSUER=nexi-backend
JWT_AUDIENCE=nexi-mobile
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
VERIFICATION_CODE_TTL_MINUTES=10
EXPOSE_DEVELOPMENT_CODES=true
# Yalnizca guvenilir bir vekil sunucunun arkasindayken true yapin: acikken
# istemci adresi X-Forwarded-For basligindan okunur.
TRUST_PROXY_HEADERS=false
# Yarim kalan yuklemelerin kac saat sonra temizlenecegi.
ABANDONED_UPLOAD_TTL_HOURS=24
# Video sinirlari
MAX_VIDEO_SIZE_BYTES=26214400
MAX_VIDEO_DURATION_SECONDS=180
MAX_VIDEO_PIXELS=8294400
# Bildirim saklama suresi
NOTIFICATION_RETENTION_DAYS=30
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=nexi
STORAGE_SECRET_KEY=nexi_dev_storage_password
STORAGE_BUCKET=nexi-media
MAX_IMAGE_SIZE_BYTES=10485760
MAX_VIDEO_SIZE_BYTES=26214400

# Akis deneyi. FEED_PERSONALIZATION_ENABLED=false oldurme anahtaridir:
# tek ayarla herkesi kronolojige alir.
FEED_PERSONALIZATION_ENABLED=true
FEED_EXPERIMENT=heuristic:1
# FEED_SHADOW_VARIANT=learned
FEED_EXPERIMENT_SALT=nexi-feed-v1
# Oneri olaylari ve akis soy kutugu bu suredem sonra silinir.
RECOMMENDATION_RETENTION_DAYS=180
